<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <_ContentIncludedByDefault Remove="wwwroot\css\site.css" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DartSassBuilder" />
        <PackageReference Include="Nodsoft.MoltenObsidian.Blazor" />
        <PackageReference Include="Nodsoft.MoltenObsidian.Vaults.Http" />
        <PackageReference Include="Serilog.AspNetCore" />
        <PackageReference Include="Serilog.Extensions.Logging" />
        <PackageReference Include="Microsoft.Web.LibraryManager.Build" />
        
        <!-- Used for fixing arm64 build issues -->
        <PackageReference Include="Microsoft.ClearScript.V8.Native.win-arm64" Condition="'$(RuntimeIdentifier)' == 'win-arm64'" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Docs" />
    </ItemGroup>

    <PropertyGroup>
        <DartSassOutputStyle>compressed</DartSassOutputStyle>
        <DartSassOutputStyle Condition="'$(Configuration)' == 'Debug'">expanded</DartSassOutputStyle>
        <DartSassOutputLevel>verbose</DartSassOutputLevel>
    </PropertyGroup>

    <ItemGroup>
        <!--     <SassFile Include="wwwroot\css\app.scss" /> -->
        <!--     <SassFile Include="**/*.razor.scss" /> -->
        <None Update="**/*.css" Visible="false" />
        <Content Update="**/*.css" Visible="false" />

        <Content Include=".config/dotnet-tools.json" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\SocialGuard.ServiceDefaults\SocialGuard.ServiceDefaults.csproj" />
    </ItemGroup>

</Project>
